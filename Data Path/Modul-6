NumPy (Numerical Python)
Alat/mesin untuk mempermudah perhitungan dalam data
Tidak butuh looping, fast array



import numpy as np

kadar_air = np.array([12.5, 15.4, 9.8, 20.1, 11.2, 18.7])

print(kadar_air.mean())    # rata-rata
print(np.median(kadar_air)) # nilai tengah
print(kadar_air.std())     # standar deviasi (seberapa "nyebar" datanya)
print(kadar_air.min())     # nilai terkecil
print(kadar_air.max())     # nilai terbesar
